<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.agav.job-tick</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/agav</string>
		<string>--internal-background-jobs-tick</string>
	</array>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>{{HOME}}/.agav/logs/job-tick.out.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/.agav/logs/job-tick.err.log</string>
</dict>
</plist>
