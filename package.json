{
  "name": "agav-cli",
  "version": "0.2.6",
  "description": "Terminal-native AI coding assistant for real repositories",
  "type": "module",
  "bin": {
    "agav": "./build/cli.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "gen:skills": "node scripts/gen-bundled-skills.mjs",
    "build": "pnpm gen:skills && tsc && node -e \"require('fs').copyFileSync('source/cli.tsx','build/cli.js')\" && node -e \"require('fs').cpSync('source/agents/bundled','build/agents/bundled',{recursive:true})\" && node -e \"require('fs').cpSync('source/skills/bundled','build/skills/bundled',{recursive:true})\" && node -e \"require('fs').copyFileSync('source/agents/sandbox-exec.mjs','build/agents/sandbox-exec.mjs')\"",
    "dev": "tsx --watch source/cli.tsx",
    "start": "tsx source/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run source",
    "test:coverage": "vitest run --coverage",
    "test:installer": "sh scripts/tests/run-installer-tests.sh",
    "build:binary": "node scripts/build-binary.mjs native",
    "build:binary:voice": "node scripts/build-binary.mjs native --voice",
    "build:binary:all": "node scripts/build-binary.mjs all",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.1",
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "ansi-escapes": "^7.3.0",
    "chalk": "^6.0.1",
    "cli-boxes": "^4.0.1",
    "cli-cursor": "^5.0.0",
    "fflate": "^0.8.3",
    "indent-string": "^5.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "ollama": "^0.6.4",
    "openai": "^7.41.0",
    "pdfjs-dist": "^6.4.299",
    "react": "~19.3.1",
    "react-reconciler": "0.33.0",
    "scheduler": "^0.27.0",
    "slice-ansi": "^9.0.1",
    "string-width": "^8.3.0",
    "widest-line": "^6.0.0",
    "yaml": "^2.9.1",
    "yoga-layout": "3.2.1"
  },
  "devDependencies": {
    "@sindresorhus/tsconfig": "^8.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-reconciler": "0.33.0",
    "@types/scheduler": "^0.26.0",
    "@vitest/coverage-v8": "~4.1.12",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "~4.1.12"
  }
}
