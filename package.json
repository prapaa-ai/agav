{
  "name": "agav-cli",
  "version": "0.2.1-beta.5",
  "description": "Terminal-native AI coding assistant for real repositories",
  "type": "module",
  "bin": {
    "agav": "./build/cli.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "gen:skills": "node scripts/gen-bundled-skills.mjs",
    "build": "pnpm gen:skills && tsc && node -e \"require('fs').copyFileSync('source/cli.tsx','build/cli.js')\" && node -e \"require('fs').cpSync('source/agents/bundled','build/agents/bundled',{recursive:true})\" && node -e \"require('fs').cpSync('source/skills/bundled','build/skills/bundled',{recursive:true})\" && node -e \"require('fs').copyFileSync('source/agents/sandbox-exec.mjs','build/agents/sandbox-exec.mjs')\"",
    "dev": "tsx --watch source/cli.tsx",
    "start": "tsx source/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run source",
    "test:coverage": "vitest run --coverage",
    "test:installer": "sh scripts/tests/run-installer-tests.sh",
    "build:binary": "pnpm gen:skills && bun build source/cli.tsx --compile --outfile dist/agav",
    "build:binary:all": "bash scripts/build-binary.sh all",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@anthropic-ai/sdk": "^0.123.0",
    "ajv": "^8.20.0",
    "ansi-escapes": "^7.3.0",
    "chalk": "^5.4.0",
    "cli-boxes": "^4.0.1",
    "cli-cursor": "^5.0.0",
    "fflate": "^0.8.3",
    "indent-string": "^5.0.0",
    "marked": "^15.0.0",
    "marked-terminal": "^7.3.0",
    "ollama": "^0.6.3",
    "openai": "^7.9.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-reconciler": "0.33.0",
    "scheduler": "^0.27.0",
    "slice-ansi": "^9.0.0",
    "string-width": "^8.2.2",
    "widest-line": "^6.0.0",
    "yaml": "^2.3.4",
    "yoga-layout": "3.2.1"
  },
  "devDependencies": {
    "@sindresorhus/tsconfig": "^8.1.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-reconciler": "^0.33.0",
    "@types/scheduler": "^0.26.0",
    "@vitest/coverage-v8": "^2.1.8",
    "husky": "^9.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "vitest": "^2.1.8"
  }
}
