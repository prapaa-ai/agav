{
  "compilerOptions": {
    "outDir": "build",
    "rootDir": "./source",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": [
      "es2022"
    ]
  },
  "include": [
    "source"
  ],
  "exclude": [
    "node_modules",
    "build",
    "**/*.kt",
    "**/*.kts"
  ]
}